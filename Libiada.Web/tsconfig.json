{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "strict": true,
    "alwaysStrict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    //"noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "rootDir": "./wwwroot/js/",
    "outDir": "./wwwroot/js/",
    //"allowJs": true,
    //"checkJs": true,
    //"declaration": true,
    //"types": [ "angular" ],
    "typeRoots": [
      "wwwroot/lib/microsoft",
      "wwwroot/lib/@types"
    ],
    "allowUmdGlobalAccess": true
    // "noEmitOnError": true

  },
  "include": [
    "wwwroot/js/**/*.ts"
  ],
  "exclude": [
    //"node_modules",
    //"wwwroot/lib",
    //"wwwroot/lib/!([@types]/**)"

  ]
}
