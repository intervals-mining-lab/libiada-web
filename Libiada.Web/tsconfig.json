{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    //"noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "allowUmdGlobalAccess": true,
    "rootDir": "./wwwroot/",
    "outDir": "./wwwroot/",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    //"declaration": true,
    "types": [ "angular", "plotly.js", "d3", "bootstrap", "jquery" ],
    "typeRoots": [
      "wwwroot/lib/microsoft",
      "wwwroot/lib/@types"
    ],
    "paths": {
      //"/lib/*": [ "/wwwroot/lib/*" ],
      "functions": [ "./wwwroot/js/Angular/functions.ts" ],
      "viewDataTypes": [ "./wwwroot/js/Angular/viewDataTypes.ts" ],
      "bootstrap": [ "./wwwroot/lib/twitter-bootstrap/js/bootstrap.esm.js" ],
      "excelJS": ["./wwwroot/lib/exceljs"]
    }
    // "noEmitOnError": true

  },
  "include": [
    "wwwroot/js/**/*.ts"
  ],
  "exclude": [
    //"wwwroot/lib/twitter-bootstrap"
    //"node_modules",
    //"wwwroot/lib",
    //"wwwroot/lib/!([@types]/**)"

  ]
}
