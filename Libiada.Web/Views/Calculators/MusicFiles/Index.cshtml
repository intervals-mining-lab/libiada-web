@{
    ViewBag.Title = "Libiada - WAV files processor";
}

<h2>@ViewBag.Title</h2>

<form asp-action="Index" asp-controller="MusicFiles" method="post" enctype="multipart/form-data">
    <div ng-controller="MusicFilesCtrl">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row mb-2">
            <label class="col-form-label col-md-2" for="file">WAV files:</label>
            <div class="col-md-10">
                <input class="form-control" type="file" name="file" id="file" multiple />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-10">
                <input type="submit" value="Calculate" class="btn btn-secondary" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_AngularControllerInitializer" model='@("MusicFiles")' />
}
