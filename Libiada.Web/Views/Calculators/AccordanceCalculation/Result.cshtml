@{
    ViewBag.Title = "Libiada - Accordance characteristics calculation";
}

<h2>@ViewBag.Title</h2>

@if (ViewBag.Error == null)
{
    <div ng-controller="AccordanceResultCtrl">
        <h4 class="mb-2" ng-bind="::researchObjectNames[0]"></h4>
        <h4 ng-bind="::researchObjectNames[1]"></h4>
        <div ng-switch="calculationType">
            <div ng-switch-when="Equality">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Element name</th>
                            <th ng-bind="::characteristicName + ' first to second'" />
                            <th ng-bind="::characteristicName + ' second to first'">
                                <br />
                                Reverse order
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="element in ::alphabet">
                            <td ng-bind="::alphabet[$index]" />
                            <td ng-bind="::characteristics[0][$index]" />
                            <td ng-bind="::characteristics[1][$index]" />
                        </tr>
                    </tbody>
                </table>
            </div>
            <div ng-switch-when="All">
                <p ng-bind="::characteristicName"></p>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Element nam</th>
                            <th ng-repeat="element in ::secondAlphabet"
                                ng-bind="::element" />
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="element in ::firstAlphabet">
                            <td ng-bind="::element" />
                            <td ng-repeat="characteristic in ::characteristics[$index]"
                                ng-bind="::characteristics[$parent.$index][$index]" />
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_AngularControllerInitializer", "AccordanceResult");
        }
    }
}
