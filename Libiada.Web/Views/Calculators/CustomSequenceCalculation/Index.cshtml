@{
    ViewBag.Title = "Custom sequence characteristics";
}

<h2>@ViewBag.Title</h2>

<form asp-action="Index" asp-controller="CustomSequenceCalculation" method="post" enctype="multipart/form-data">
    <div ng-controller="CustomSequenceCalculationCtrl">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <custom-sequences image-transformers="::imageTransformers"></custom-sequences>

        <characteristics characteristic-types="::characteristicTypes"
                         characteristics-dictionary="::characteristicsDictionary"
                         nature="nature"
                         notations="::notations"
                         pause-treatments="::pauseTreatments"
                         trajectories="::trajectories"
                         hide-notation="true">
        </characteristics>
        <div class="row mb-2">
            <div class="col-md-10">
                <input type="submit" value="Calculate" class="btn btn-secondary" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script type="module" src="~/js/Angular/Components/characteristics.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/customSequences.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("CustomSequenceCalculation")' />
}
