@{
    ViewBag.Title = "Order transformation visualization";
}

<h2>@ViewBag.Title</h2>

<form method="post" asp-antiforgery="true">
    <div ng-controller="OrderTransformationVisualizationCtrl">
        <h4>Parameters</h4>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row mb-1">
            <label class="col-form-label col-md-2" for="length">Generated sequences length:</label>
            <div class="col-md-10">
                <input class="form-control" name="length" type="number" value="4" min="2" id="length" />
                @Html.ValidationMessage("length", "", new { @class = "text-danger" })
            </div>
        </div>
        <research-objects-submit submit-name="Generate orders"></research-objects-submit>
    </div>
</form>

@section Scripts {
    <script type="module" src="~/js/Angular/Components/researchObjectsSubmit.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("OrderTransformationVisualization")' />
}