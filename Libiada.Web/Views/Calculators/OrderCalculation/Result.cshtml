@{
    Layout = "_EmptyLayout";
    ViewBag.Title = "Libiada - Orders characteristics calculation result";
}

@if (ViewBag.Error == null)
{
    <div class="no-margin" ng-controller="OrderCalculationResultCtrl">
        <loading-window loading="loading" loading-screen-header="loadingScreenHeader"></loading-window>
        @* dirty hack to prevent components from loading before server data *@
        <div ng-if="loading === false">
            <ul id='nav' class="nav nav-tabs d-flex justify-content-evenly pt-1" role="tablist">
                <li class="nav-item" role="presentation" title="Charts">
                    <button class="nav-link active"
                            id="charts-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#charts-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="charts-tab-pane"
                            aria-selected="true">
                        Charts
                    </button>
                </li>
                <li class="nav-item" role="presentation" title="Data table" ng-click="characteristicsTableTabSelected = true">
                    <button class="nav-link"
                            id="data-table-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#data-table-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="data-table-tab-pane"
                            aria-selected="false">
                        Data
                    </button>
                </li>
            </ul>
            <div class="tab-content tab-content-full-height">

                <div id="charts-tab-pane"
                     class="tab-pane fade show active"
                     role="tabpanel"
                     aria-labelledby="charts-tab"
                     tabindex="0">
                    <characteristics-visualizations characteristics-list="characteristicsList"
                                                    characteristic-names="characteristicNames"
                                                    characteristics="characteristics"
                                                    sequence-groups="sequenceGroups">
                    </characteristics-visualizations>
                </div>
                <div id="data-table-tab-pane"
                     class="tab-pane fade"
                     role="tabpanel"
                     aria-labelledby="data-table-tab"
                     tabindex="0">
                    <characteristics-table characteristic-names="characteristicNames"
                                           characteristics="characteristics"
                                           characteristics-table-tab-selected="characteristicsTableTabSelected">
                    </characteristics-table>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script type="module" src="~/js/Angular/Components/characteristicsVisualizations.js" asp-append-version="true"></script>
        <script type="module" src="~/js/Angular/Components/characteristicsTable.js" asp-append-version="true"></script>
        @{
            await Html.RenderPartialAsync("_AngularControllerInitializer", "OrderCalculationResult");
        }
    }
}
