@{
    ViewBag.Title = "Subsequences characteristics distribution";
}

<h2>@ViewBag.Title</h2>


<form method="post" asp-antiforgery="true">
    <div ng-controller="SubsequencesDistributionCtrl">
        <h4>Sequences and parameters</h4>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <research-objects-table research-objects-endpoint="GetResearchObjectsWithSubsequences"
                                nature="nature"
                                groups="groups"
                                sequence-types="sequenceTypes"
                                maximum-selected-research-objects="::maximumSelectedResearchObjects"
                                selected-research-objects-count="selectedResearchObjectsCount"
                                group-and-type-required="::false">
        </research-objects-table>

        <features-select features="::features"></features-select>

        <hr />
        <characteristic characteristic-types="::characteristicTypes"
                        characteristics-dictionary="::characteristicsDictionary"
                        nature="nature"
                        notations="::notations">
        </characteristic>
        <characteristics characteristic-types="::characteristicTypes"
                         characteristics-dictionary="::characteristicsDictionary"
                         nature="nature"
                         notations="::notations"
                         hide-notation="true">
        </characteristics>
        <research-objects-submit selected-research-objects-count="selectedResearchObjectsCount"
                                 minimum-selected-research-objects="{{::minimumSelectedResearchObjects}}">
        </research-objects-submit>
    </div>
</form>

@section Scripts {
    <script type="module" src="~/js/Angular/Components/characteristic.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/characteristics.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsTable.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsSubmit.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/featuresSelect.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("SubsequencesDistribution")' />
}
