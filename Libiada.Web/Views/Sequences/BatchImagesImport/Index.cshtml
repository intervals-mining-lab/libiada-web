@{
    ViewBag.Title = "Libiada - Batch images import";
}

<h2>@ViewBag.Title</h2>

<form asp-action="Index" asp-controller="BatchImagesImport" method="post" enctype="multipart/form-data">
    <div ng-controller="BatchImagesImportCtrl">
        <div class="row mb-1">
            <label class="col-form-label col-md-2" for="files">Images files:</label>
            <div class="col-md-10">
                <input type="file" name="files" id="files" multiple onChange="angular.element(this).scope().fileChanged(this)" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="offset-md-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-secondary" ng-disabled="!fileSelected.value" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_AngularControllerInitializer" model='@("BatchImagesImport")' />
}
