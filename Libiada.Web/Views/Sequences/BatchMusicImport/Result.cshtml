@{
    ViewBag.Title = "Batch music import result";
}

<h2>@ViewBag.Title</h2>

@if (ViewBag.Error == null)
{
    await Html.RenderPartialAsync("_AngularControllerInitializer", "BatchMusicImportResult");

    <div ng-controller="BatchMusicImportResultCtrl">
        <loading-window loading="loading" loading-screen-header="loadingScreenHeader"></loading-window>
        <div ng-disabled="loading">
            <import-results-table result="result" has-group-and-sequence-type="true"></import-results-table>
        </div>
    </div>

    @section Scripts {
        <script type="module" src="~/js/Angular/Components/importResultsTable.js" asp-append-version="true"></script>
    }
}
