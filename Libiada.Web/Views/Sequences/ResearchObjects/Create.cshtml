@model CombinedSequenceEntity

@{
    ViewBag.Title = "Libiada - Create research object";
}

<h2>@ViewBag.Title</h2>

<div>@ViewBag.ErrorMessage</div>

<form asp-action="Create" asp-controller="ResearchObjects" method="post" enctype="multipart/form-data">
    <div ng-controller="ResearchObjectCreateCtrl">
        <h4>Research object and sequence parameters</h4>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (User.IsAdmin())
        {
            <div class="row mb-1">
                <label asp-for="ResearchObject.Nature" class="col-form-label col-md-2"></label>
                <div class="col-md-10">
                    <select class="form-select"
                            ng-model="nature"
                            ng-options="n.Value as n.Text for n in ::natures"
                            ng-change="filterByNature()"
                            ng-init="filterByNature()"></select>
                    <input type="hidden" name="ResearchObject.Nature" ng-value="nature" />
                    <span asp-validation-for="ResearchObject.Nature" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-1" ng-hide="nature === '@((byte)Nature.Music)'">
                <label asp-for="Notation" class="col-form-label col-md-2"></label>
                <div class="col-md-10">
                    <select class="form-select"
                            ng-options="n.Value as n.Text for n in notations | filter:{ Nature: nature }"
                            ng-model="notation"></select>
                    <input type="hidden" name="Notation" ng-value="notation" />
                    <span asp-validation-for="Notation" class="text-danger"></span>
                </div>
            </div>
        }
        else
        {
            <div ng-hide="true" ng-init="filterByNature()"></div>
            <input type="hidden" name="Notation" ng-value="notation" />
            <input type="hidden" name="ResearchObject.Nature" ng-value="nature" />
        }

        <div class="row mb-1">
            <label asp-for="ResearchObject.Name" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="ResearchObject.Name" class="form-control" ng-model="name" />
                <span asp-validation-for="ResearchObject.Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.Description" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="ResearchObject.Description" class="form-control" ng-model="description" />
                <span asp-validation-for="ResearchObject.Description" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.Group" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <select class="form-select"
                        ng-options="g.Value as g.Text for g in groups | filter:{ Nature: nature }"
                        ng-model="group"></select>
                <input type="hidden" name="ResearchObject.Group" ng-value="group" />
                <span asp-validation-for="ResearchObject.Group" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.SequenceType" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <select class="form-select"
                        ng-options="g.Value as g.Text for g in sequenceTypes | filter:{ Nature: nature }"
                        ng-model="sequenceType"></select>
                <input type="hidden" name="ResearchObject.SequenceType" ng-value="sequenceType" />
                <span asp-validation-for="ResearchObject.SequenceType" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.Multisequence" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <select class="form-select"
                        ng-options="ms.Value as ms.Text for ms in multisequences | filter:{ Nature: nature }"
                        ng-model="researchObject.MultisequenceId">
                    <option value="">-- None --</option>
                </select>
                <input type="hidden" name="ResearchObject.MultisequenceId" ng-value="researchObject.MultisequenceId" />
                <span asp-validation-for="ResearchObject.Multisequence" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.MultisequenceNumber" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="ResearchObject.MultisequenceNumber" class="form-control" />
                <span asp-validation-for="ResearchObject.MultisequenceNumber" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.CollectionCountry" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="ResearchObject.CollectionCountry" class="form-control" />
                <span asp-validation-for="ResearchObject.CollectionCountry" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-1">
            <label asp-for="ResearchObject.CollectionDate" class="col-form-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="ResearchObject.CollectionDate" class="form-control" />
                <span asp-validation-for="ResearchObject.CollectionDate" class="text-danger"></span>
            </div>
        </div>
        <local-file></local-file>
        <div ng-show="nature === '@((byte)Nature.Genetic)'">
            <div class="row mb-1">
                <label asp-for="RemoteDb" class="col-form-label col-md-2"></label>
                <div class="col-md-10">
                    <select class="form-select"
                            id="RemoteDb"
                            ng-options="r.Value as r.Text for r in remoteDbs | filter: { Nature: nature }"
                            ng-model="remoteDbId">
                        <option value="">None</option>
                    </select>
                    <input type="hidden" name="RemoteDb" ng-value="remoteDbId" />
                    <span asp-validation-for="RemoteDb" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-1" ng-show="isRemoteDbDefined()">
                <label asp-for="RemoteId" class="col-form-label col-md-2"></label>
                <div class="col-md-10">
                    <input asp-for="RemoteId" class="form-control" ng-model="remoteId" ng-change="remoteIdChanged(remoteId)" />
                    <span asp-validation-for="RemoteId" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div ng-switch="nature">
            <div ng-switch-when="@((byte)Nature.Genetic)">
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           name="partial"
                           id="partial"
                           value="true" />
                    <input type="hidden" name="partial" value="false" />
                    <label class="form-check-label" for="partial">
                        Sequence is partial (incomplete)
                    </label>
                </div>
            </div>
            <div ng-switch-when="@((byte)Nature.Literature)">
                <div class="row mb-1">
                    <label class="col-form-label col-md-2" for="language">Language of literary work:</label>
                    <div class="col-md-10">
                        <select class="form-select"
                                ng-model="languageId"
                                ng-options="l.Value as l.Text for l in languages"
                                id="language"></select>
                        <input type="hidden" name="language" ng-value="languageId" />
                        @Html.ValidationMessage("language", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           name="original"
                           id="original"
                           ng-model="original"
                           value="true" />
                    <input type="hidden" name="original" value="false" />
                    <label class="form-check-label" for="original">
                        Literary work is in original language (not in translation)
                    </label>
                </div>
                <div class="row mb-1" ng-hide="original">
                    <label class="col-form-label col-md-2" for="translator">Translator:</label>
                    <div class="col-md-10">
                        <select class="form-select"
                                ng-model="translatorId"
                                ng-options="t.Value as t.Text for t in translators"
                                id="translator"></select>
                        <input type="hidden" name="translator" ng-value="translatorId" />
                        @Html.ValidationMessage("translator", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div ng-switch-when="@((byte)Nature.Music)">
            </div>
            <div ng-switch-when="@((byte)Nature.MeasurementData)">
                <div class="row mb-1">
                    <label class="col-form-label col-md-2" for="precision">Precision of elements:</label>
                    <div class="col-md-10">
                        <input class="form-control" name="precision" id="precision" type="number" value="0" min="0" max="6" />
                        @Html.ValidationMessage("precision", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div ng-switch-when="@((byte)Nature.Image)">
            </div>
        </div>
        <div class="row mb-1">
            <div class="col-md-10">
                <input type="submit" value="Create" class="btn btn-secondary" />
            </div>
        </div>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/Angular/Components/localFile.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("ResearchObjectCreate")' />
}
