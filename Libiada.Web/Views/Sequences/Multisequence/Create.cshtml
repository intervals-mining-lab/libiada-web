@using Libiada.Web.Extensions
@using Libiada.Web.Helpers
@model Multisequence

@{
    ViewBag.Title = "Libiada - Create Multisequence";
}

<h2>@ViewBag.Title</h2>

<div>@ViewBag.ErrorMessage</div>

@using (Html.BeginForm())
{
    <div ng-controller="MultisequenceCreateCtrl">
        <h4>Multisequence parameters</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <nature-select natures="natures"
                       nature="nature">
        </nature-select>
        <div class="row mb-1">
            @Html.LabelFor(model => model.Name, new { @class = "col-form-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <research-objects-table research-objects-endpoint="GetResearchObjectsForMultisequence"
                                nature="nature"
                                groups="groups"
                                sequence-types="sequenceTypes"
                                maximum-selected-research-objects="::maximumSelectedResearchObjects"
                                selected-research-objects-count="selectedResearchObjectsCount"
                                display-multisequence-number="::displayMultisequenceNumber"
                                group-and-type-required="::false">
        </research-objects-table>
        <research-objects-submit selected-research-objects-count="selectedResearchObjectsCount"
                                 submit-name="Create"
                                 minimum-selected-research-objects="{{::minimumSelectedResearchObjects}}">
        </research-objects-submit>
        <div class="row mb-1">
            <div class="col-md-2">
                @Html.ActionLink("Back to List", "Index")
            </div>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_AngularControllerInitializer", "MultisequenceCreate");
    }
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/Angular/Components/natureSelect.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsTable.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsSubmit.js" asp-append-version="true"></script>
}
