@model SequenceGroup

@{
    ViewBag.Title = "Libiada - Sequences group edit";
}

<h2>@ViewBag.Title</h2>

<form method="post" asp-antiforgery="true">
    <div ng-controller="sequenceGroupEditCtrl">
        <h4>Sequences Group</h4>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatorId" type="hidden" />
        <input asp-for="ModifierId" type="hidden" />
        <input asp-for="Created" type="hidden" />

        <div class="row mb-1">
            <div class="col-md-10">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <nature-select natures="natures" nature="nature">
        </nature-select>
        <div class="row mb-1">
            <div class="col-md-10">
                <label class="form-label" for="sequenceGroupType">Sequence group type</label>
                <select class="form-select"
                        id="sequenceGroupType"
                        ng-options="n.Value as n.Text for n in sequenceGroupTypes | filter:{ Nature: nature }"
                        ng-model="sequenceGroupType">
                    <option value="">-- None --</option>
                </select>
                <input type="hidden" name="SequenceGroupType" ng-value="sequenceGroupType" />
            </div>
        </div>
        <research-objects-table research-objects="researchObjects"
                                nature="nature"
                                groups="groups"
                                sequence-types="sequenceTypes"
                                maximum-selected-research-objects="::maximumSelectedResearchObjects"
                                selected-research-objects-count="selectedResearchObjectsCount"
                                group-and-type-required="::true"
                                initial-sequence-type-index="sequenceTypeIndex"
                                initial-group-index="groupIndex">
        </research-objects-table>
        <research-objects-submit selected-research-objects-count="selectedResearchObjectsCount"
                                 submit-name="Save"
                                 minimum-selected-research-objects="{{::minimumSelectedResearchObjects}}">
        </research-objects-submit>
        <div class="row mb-2">
            <div class="col-md-2">
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/Angular/Components/researchObjectsTable.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/natureSelect.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsSubmit.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("SequenceGroupEdit")' />
}
