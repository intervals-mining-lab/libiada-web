@{
    ViewBag.Title = "Sequence check result";
}
<h2>@ViewBag.Title</h2>

@if (ViewBag.Error == null)
{
    <div ng-controller="SequenceCheckResultCtrl">
        <loading-window loading="loading" loading-screen-header="loadingScreenHeader"></loading-window>
        <h3>Comparing local sequence sequence: {{::dbSequenceName}} with external sequence {{::fileSequenceName}}</h3>
        <h4 ng-class="calculateStatusClass(status)" ng-bind="::message"></h4>
        <h6 class="mb-2">
            @Html.ActionLink("Check another sequence", "Index")
        </h6>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_AngularControllerInitializer", "SequenceCheckResult");
        }
    }
}
