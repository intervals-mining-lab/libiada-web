@{
    ViewBag.Title = "Transformation of order of sequences";
}

<h2>@ViewBag.Title</h2>

<form method="post" asp-antiforgery="true">
    <div ng-controller="OrderTransformerCtrl">
        <nature-select natures="natures"
                       nature="nature">
        </nature-select>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <research-objects-table research-objects="researchObjects"
                                nature="nature"
                                groups="groups"
                                sequence-types="sequenceTypes"
                                maximum-selected-research-objects="::maximumSelectedResearchObjects"
                                selected-research-objects-count="selectedResearchObjectsCount"
                                group-and-type-required="::false">
        </research-objects-table>
        <characteristic-nature-params nature="nature"
                                      notations="notations"
                                      languages="::languages"
                                      translators="::translators"
                                      pause-treatments="::pauseTreatments"
                                      trajectories="::trajectories">
        </characteristic-nature-params>
        <order-transformations transformations="::transformations">
        </order-transformations>
        <research-objects-submit selected-research-objects-count="selectedResearchObjectsCount"
                                 submit-name="Transform"
                                 minimum-selected-research-objects="{{::minimumSelectedResearchObjects}}">
        </research-objects-submit>
    </div>
</form>

@section Scripts {
    <script type="module" src="~/js/Angular/Components/orderTransformations.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/characteristicNatureParams.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsTable.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/natureSelect.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Angular/Components/researchObjectsSubmit.js" asp-append-version="true"></script>
    <partial name="_AngularControllerInitializer" model='@("OrderTransformer")' />
}
