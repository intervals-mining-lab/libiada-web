@{
    ViewBag.Title = "Segmentation results";
}

<h2>@ViewBag.Title</h2>
@if (ViewBag.Error == null)
{
    await Html.RenderPartialAsync("_AngularControllerInitializer", "PoemSegmentationResult");
    <div ng-controller="PoemSegmentationResultCtrl">
        <h3>{{poemName}}</h3>
        <table class="table table-bordered table-hover" ng-cloak>
            <thead>
                <tr>
                    <th>Consonance</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="(key, value) in segmentedString">
                    <td>{{key}}</td>
                    <td>{{value}}</td>
                </tr>
            </tbody>
        </table>
        <h4>Segmented Text</h4>
        <p>
            {{segmentedText}}
        </p>
        <hr />
        <h4>Sequence</h4>
        <p>
            {{poemSequence}}
        </p>
    </div>

    @section Scripts {
    }
}
