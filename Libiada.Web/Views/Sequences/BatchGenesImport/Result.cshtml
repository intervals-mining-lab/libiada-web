@{
    ViewBag.Title = "Batch genes import result";
}

<h2>@ViewBag.Title</h2>

@if (ViewBag.Error == null)
{
    await Html.RenderPartialAsync("_AngularControllerInitializer", "BatchSequenceImportResult");

    <div ng-controller="BatchSequenceImportResultCtrl">
        <import-results-table result="result"></import-results-table>
    </div>

    @section Scripts {
        <script type="module" src="~/js/Angular/Components/importResultsTable.js" asp-append-version="true"></script>
    }
}
