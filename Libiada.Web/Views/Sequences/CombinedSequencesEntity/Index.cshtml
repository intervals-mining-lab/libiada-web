@model IEnumerable<CombinedSequenceEntity>

@{
    ViewBag.Title = "Sequences list";
}

<h2>@ViewBag.Title</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered table-hover">
    <tr>
        <th>@Html.DisplayNameFor(model => model.ResearchObjectId)</th>
        <th>@Html.DisplayNameFor(model => model.Notation)</th>
        <th>@Html.DisplayNameFor(model => model.Created)</th>
        <th>@Html.DisplayNameFor(model => model.Modified)</th>
        <th>@Html.DisplayNameFor(model => model.RemoteId)</th>
        <th>@Html.DisplayNameFor(model => model.RemoteDb)</th>
        <th />
    </tr>

    @foreach (CombinedSequenceEntity item in ViewBag.Sequences)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.ResearchObject.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Notation)</td>
            <td>@Html.DisplayFor(modelItem => item.Created)</td>
            <td>@Html.DisplayFor(modelItem => item.Modified)</td>
            <td>@Html.DisplayFor(modelItem => item.RemoteId)</td>
            <td>@Html.DisplayFor(modelItem => item.RemoteDb)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }

</table>
