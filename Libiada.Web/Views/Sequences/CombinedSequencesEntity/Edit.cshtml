@model CombinedSequenceEntity

@{
    ViewBag.Title = "Edit sequence";
}

<h2>@ViewBag.Title</h2>


<form method="post" asp-antiforgery="true">
    <h4>Sequence</h4>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />

    <div class="row mb-1">
        <label asp-for="Notation" class="col-form-label col-md-2">Notation</label>
        <div class="col-md-10">
            <select asp-for="Notation" asp-items="ViewBag.Notation" class="form-select"></select>
            <span asp-validation-for="Notation" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-1">
        <label asp-for="ResearchObjectId" class="col-form-label col-md-2">ResearchObject</label>
        <div class="col-md-10">
            <select asp-for="ResearchObjectId" asp-items="ViewBag.ResearchObjectId" class="form-select"></select>
            <span asp-validation-for="ResearchObjectId" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-1">
        <label asp-for="RemoteDb" class="col-form-label col-md-2">Remote database</label>
        <div class="col-md-10">
            <select asp-for="RemoteDb" asp-items="ViewBag.RemoteDb" class="form-select"></select>
            <span asp-validation-for="RemoteDb" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-1">
        <label asp-for="RemoteId" class="col-form-label col-md-2"></label>
        <div class="col-md-10">
            <input asp-for="RemoteId" class="form-control" />
            <span asp-validation-for="RemoteId" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-2">
        <div class="offset-md-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-secondary" />
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
