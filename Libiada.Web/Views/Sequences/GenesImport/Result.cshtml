@{
    ViewBag.Title = "Subsequences import results";
}

@if (ViewBag.Error == null)
{
    await Html.RenderPartialAsync("_AngularControllerInitializer", "GenesImportResult");

    <div ng-controller="GenesImportResultCtrl">
        <loading-window loading="loading" loading-screen-header="loadingScreenHeader"></loading-window>
        <h3 class="my-3">Subsequences import results for <span class="fw-bold" ng-bind="::researchObjectName"></span></h3>
        <table class="table table-bordered table-hover table-sm" ng-cloak>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Feature</th>
                    <th>Gene position</th>
                    <th>Gene length</th>
                    <th>Partial</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="gene in ::genes">
                    <td ng-bind="::$index + 1" />
                    <td ng-bind="::features[gene.FeatureId]" />
                    <td>
                        <p ng-repeat="start in ::gene.Starts track by $index">
                            {{::start}}
                        </p>
                    </td>
                    <td>
                        <p ng-repeat="length in ::gene.Lengths track by $index">
                            {{::length}}
                        </p>
                    </td>
                    <td ng-bind="::gene.Partial ? 'Partial': 'Complete'" />
                </tr>
            </tbody>
        </table>
    </div>

    @section Scripts {
    }
}
