<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - FOA Research Lab</title>

    <partial name="_SharedScriptsPartial.cshtml" />

    <link rel="stylesheet" href="~/css/VerticalAdaptive.css" asp-append-version="true" />

    @await RenderSectionAsync("Scripts", required: false)
</head>
<body class="vh-100 m-0 p-0">
    <div ng-app="libiada">
        @RenderBody()
        <partial name="_ErrorPartial.cshtml" />
    </div>
</body>
</html>
