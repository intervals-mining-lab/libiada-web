@model string

<script type="module">
    import controllerConstructor from "/js/Angular/Controllers/@(Model).js";

    @if(ViewBag.data != null)
    {
        @:let data = @Html.Raw(ViewBag.data ?? "{}");
        @:controllerConstructor(data);
    }
    else
    {
        @:controllerConstructor();
    }
</script>
