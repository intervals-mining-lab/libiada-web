@{
    ViewBag.Title = "Libiada";
    string separator = " | ";
}

<h1>Libiada - FOA Research Lab</h1>

@if (User.Identity == null ? false : User.Identity.IsAuthenticated)
{
    <div class="row mb-3">
        <div class="col-md-4">
            <h2>Data</h2>

            @if (User.IsAdmin())
            {
                <a asp-action="Index" asp-controller="ResearchObjects">Research objects</a>
                @separator
                <a asp-action="Create" asp-controller="ResearchObjects">Create research object</a>
                <br />
                <a asp-action="Index" asp-controller="Multisequence">Multisequences</a>
                <br />
                <a asp-action="Index" asp-controller="CombinedSequencesEntity">Sequences</a>
                @separator
                <a asp-action="Create" asp-controller="CombinedSequencesEntity">Create sequence</a>
                <br />
                <a asp-action="Index" asp-controller="BatchPoemsImport">Batch poems import</a>
                <br />
                <a asp-action="Index" asp-controller="BatchMusicImport">Batch music import</a>
                <br />
                <a asp-action="Index" asp-controller="BatchImagesImport">Batch image import</a>
                <br />
                <a asp-action="Index" asp-controller="BatchSequenceImport">Batch sequences import</a>
                <br />
                <a asp-action="Index" asp-controller="GenesImport">Genes import</a>
                <br />
                <a asp-action="Index" asp-controller="BatchGenesImport">Batch genes import</a>
                <br />
                <a asp-action="Index" asp-controller="BatchGeneticImportFromGenBankSearchFile">Batch genetic import from GenBank search file</a>
                <br />
                <a asp-action="Index" asp-controller="BatchGeneticImportFromGenBankSearchQuery">Batch genetic import from GenBank search query</a>
                <br />
                <a asp-action="Index" asp-controller="NcbiNuccoreSearch">GenBank search</a>
                <br />
                <a asp-action="Index" asp-controller="GenBankAccessionVersionUpdateChecker">GenBank accessions update check</a>
                <br />
                <a asp-action="Index" asp-controller="SequenceGroups">Sequences groups</a>
                <br />
                <a asp-action="Index" asp-controller="GeneticSequencesTransformation">Genetic sequences transformation</a>
                <br />
                <a asp-action="Index" asp-controller="FmotifsDictionary">Music fmotifs dictionaries</a>
                <br />
                <a asp-action="Index" asp-controller="CustomSequenceSegmentation">Custom sequences segmentation</a>
                <br />
                <a asp-action="Index" asp-controller="PoemSegmentation">Poems segmentation</a>
            }
            <br />
            <a asp-action="Index" asp-controller="OrderTransformer">Order transformation (high order)</a>
            <br />
            <a asp-action="Index" asp-controller="CustomSequenceOrderTransformer">Custom sequences order transformation (high order)</a>
        </div>
        <div class="col-md-4">
            <h2>Calculators</h2>
            <a asp-action="Index" asp-controller="Calculation">Calculation of integral characteristics</a>
            <br />
            <a asp-action="Index" asp-controller="CustomSequenceCalculation">Calculation of integral characteristics of custom sequences</a>
            <br />
            <a asp-action="Index" asp-controller="SubsequencesDistribution">Map of genes</a>
            <br />
            <a asp-action="Index" asp-controller="SubsequencesComparer">Matrix of similarity</a>
            <br />
            @if (User.IsAdmin())
            {
                <a asp-action="Index" asp-controller="LocalCalculation">Sliding window calculation (Functions of sequences)</a>
                <br />
                <a asp-action="Index" asp-controller="Clusterization">Cluster analysis</a>
                <br />
                <a asp-action="Index" asp-controller="SequencesAlignment">Alignment of sequences</a>
                <br />
                <a asp-action="Index" asp-controller="SubsequencesCalculation">Subsequences characteristics calculation</a>
                <br />
                <a asp-action="Index" asp-controller="SubsequencesSimilarity">Subsequences similarity</a>
                <br />
                <a asp-action="Index" asp-controller="CongenericCalculation">Calculation of characteristics of congeneric sequences</a>
                <br />
                <a asp-action="Index" asp-controller="RelationCalculation">Calculation of relation characteristics of congeneric sequences</a>
                <br />
                <a asp-action="Index" asp-controller="AccordanceCalculation">Calculation of accordance characteristics of congeneric sequences</a>
                <br />
                <a asp-action="Index" asp-controller="OrderTransformationCalculation">Order transformation (high order) characteristics calculation</a>
                <br />
                <a asp-action="Index" asp-controller="CustomSequenceOrderTransformationCalculation">Custom sequences order transformation (high order) characteristics calculation</a>
            }
        </div>
        <div class="col-md-4">
            <h2>Tasks</h2>
            <a asp-action="Index" asp-controller="TaskManager">Task manager</a>

            <h2>FOA Research</h2>
            <a asp-action="Index" asp-controller="Charts">Data visualization</a>
            <br />
            @if (User.IsAdmin())
            {
                <a asp-action="Index" asp-controller="OrderTransformationConvergence">Calculate order transformations convergence</a>
                <br />
                <a asp-action="Index" asp-controller="SequencesOrderDistribution">Calculate distribution of sequences by order</a>
                <br />
                <a asp-action="Index" asp-controller="OrdersIntervalsDistributionsAccordance">Calculate accordance of orders by intervals distributions</a>
                <br />
                <a asp-action="Index" asp-controller="IntervalsCharacteristicsDistribution">Calculate characteristics of intervals distributions</a>
                <br />
                <a asp-action="Index" asp-controller="MusicFiles">Music files processor</a>
                <br />
                <a asp-action="Index" asp-controller="SequencePrediction">Sequence predictions</a>
                <br />
                <a asp-action="Index" asp-controller="OrderCalculation">Calculation of integral characteristics of orders</a>
                <br />
                <a asp-action="Index" asp-controller="OrderTransformationVisualization">Visualization of orders transformations</a>
                <br />
                <a asp-action="Index" asp-controller="OrderTransformationCharacteristicsDynamicVisualization">Visualization of orders transformations characteristics dynamic</a>
            }
        </div>
    </div>
}
else
{
    <div class="mb-3 fs-5">
        <a asp-area="Identity" asp-page="/Account/Login">Log in</a> or
        <a asp-area="Identity" asp-page="/Account/Register">Register</a> to use Libiada service.
    </div>
}
